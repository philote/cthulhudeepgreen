<section class="exposure-panel {{#if isGM}}editable{{else}}disabled{{/if}}">
    <div class="exposure">
        <div class="clock" data-action="changeExposure" style="--areas: {{max}}; --filled: {{currentExposure}}">
            {{#each spokes}}
                <div class="spoke" style="--index: {{ this }}"></div>
            {{/each}}
        </div>
        <div class="name flexcol">
            <span data-action="clearExposure">{{exposureTitle}}</span>
        </div>
    </div>
</section>